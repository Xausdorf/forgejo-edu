{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content edu assignment-detail">
	<div class="ui container">
		{{template "edu/navbar" .}}
		{{template "base/alert" .}}

		<div class="ui grid">
			<div class="sixteen wide column">
				<h1 class="ui header">
					{{.Assignment.Title}}
				</h1>
				<div class="ui segment">
					<p>{{.Assignment.Description | SanitizeHTML}}</p>
					{{if .Assignment.DeadlineUnix}}
						<p>
							<strong>{{ctx.Locale.Tr "edu.deadline"}}:</strong> {{.Assignment.Deadline.Format "02 Jan 2006 15:04"}}
							{{if .DeadlinePassed}}
								<span class="ui red label">{{ctx.Locale.Tr "edu.deadline_passed"}}</span>
							{{end}}
						</p>
					{{end}}
				</div>

				<div class="ui segment">
					{{if .Submission}}
						<h3 class="ui header">
							{{ctx.Locale.Tr "edu.status"}}:
							<span class="ui label {{if eq (printf "%s" .Submission.Status) "done"}}green{{else if eq (printf "%s" .Submission.Status) "failed"}}red{{else if eq (printf "%s" .Submission.Status) "running"}}blue{{else if eq (printf "%s" .Submission.Status) "approved"}}olive{{else if eq (printf "%s" .Submission.Status) "merged"}}purple{{else}}grey{{end}}">
								{{.Submission.Status}}
							</span>
						</h3>
						<p>
							<strong>{{ctx.Locale.Tr "edu.fork_branch_link"}}:</strong>
							{{if .StudentForkLink}}
								<a href="{{AppSubUrl}}/{{.StudentForkLink}}" class="ui primary button">
									{{svg "octicon-git-branch"}} {{.Submission.BranchName}}
								</a>
							{{else}}
								<code>{{.Submission.BranchName}}</code>
							{{end}}
						</p>
						{{if .DeadlinePassed}}
							<p class="ui yellow message">{{ctx.Locale.Tr "edu.deadline_passed"}}</p>
						{{end}}
					{{else}}
						<p class="ui info message">{{ctx.Locale.Tr "edu.assignment_not_distributed_yet"}}</p>
					{{end}}
				</div>

				{{if .LatestTestResult}}
				<div class="ui segment">
					<h4>{{svg "octicon-check-circle"}} {{ctx.Locale.Tr "edu.latest_test_result"}}</h4>
					<p>
						{{ctx.Locale.Tr "edu.score"}}: <span class="ui label {{if ge .LatestTestResult.Score 50}}green{{else}}red{{end}}">{{.LatestTestResult.Score}}%</span>
					</p>
					<p>{{ctx.Locale.Tr "edu.commit"}}: <code>{{if ge (len .LatestTestResult.CommitSHA) 7}}{{slice .LatestTestResult.CommitSHA 0 7}}{{else}}{{.LatestTestResult.CommitSHA}}{{end}}</code></p>
					{{if .LatestTestResult.Details}}
						<p>{{.LatestTestResult.Details | SanitizeHTML}}</p>
					{{end}}
				</div>
				{{end}}

				{{if and .Submission .Submission.IsGraded}}
				<div class="ui segment">
					<h4>{{svg "octicon-star"}} {{ctx.Locale.Tr "edu.grade"}}</h4>
					<p>
						<span class="ui large purple label">{{.Submission.Grade}}/100</span>
						{{if .Submission.ManualGrade}}
							<span class="ui small orange label">{{ctx.Locale.Tr "edu.manual_grade_label"}}</span>
						{{else}}
							<span class="ui small teal label">{{ctx.Locale.Tr "edu.auto_grade"}}</span>
						{{end}}
					</p>
					{{if .Submission.Comment}}
						<p><strong>{{ctx.Locale.Tr "edu.comment"}}:</strong> {{.Submission.Comment | SanitizeHTML}}</p>
					{{end}}
				</div>
				{{end}}
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
