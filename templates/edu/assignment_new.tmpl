{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository new repo">
	<div class="ui container">
		{{template "edu/navbar" .}}
	</div>

	<div class="ui middle aligned center aligned grid">
		<div class="column">
			<form class="ui form" action="{{.Link}}" method="post">
				{{.CsrfTokenHtml}}
				<h3 class="ui top attached header">
					{{.Title}}
				</h3>
				<div class="ui attached segment">
					{{template "base/alert" .}}

					<div class="required field">
						<label for="course_id">{{ctx.Locale.Tr "edu.course"}}</label>
						<select id="course_id" name="course_id" class="ui dropdown" required>
							<option value="">{{ctx.Locale.Tr "edu.select_course"}}</option>
							{{range .Courses}}
								<option value="{{.ID}}" {{if eq .ID $.SelectedCourseID}}selected{{end}}>{{.Name}}</option>
							{{end}}
						</select>
					</div>

                    <div class="required field {{if .Err_Title}}error{{end}}">
						<label for="title">{{ctx.Locale.Tr "edu.title"}}</label>
						<input id="title" name="title" value="{{.title}}" autofocus required>
					</div>

                    <div class="field {{if .Err_Description}}error{{end}}">
						<label for="description">{{ctx.Locale.Tr "edu.description"}}</label>
						<textarea id="description" name="description">{{.description}}</textarea>
					</div>

                    <div class="required field">
						<label for="task_name">{{ctx.Locale.Tr "edu.task_name"}}</label>
						<input id="task_name" name="task_name" value="{{.task_name}}" required pattern="^[a-z0-9_-]+$" maxlength="100">
						<div class="ui small message">{{ctx.Locale.Tr "edu.task_name_help"}}</div>
					</div>

                    <div class="required field">
						<label for="allowed_files_glob">{{ctx.Locale.Tr "edu.allowed_files_glob"}}</label>
						<input id="allowed_files_glob" name="allowed_files_glob" value="{{.allowed_files_glob}}" placeholder="tasks/<task_name>/<task_name>.cpp" required>
						<div class="ui small message">{{ctx.Locale.Tr "edu.allowed_files_glob_help"}}</div>
					</div>

                    <div class="field {{if .Err_Deadline}}error{{end}}">
						<label for="deadline">{{ctx.Locale.Tr "edu.deadline"}}</label>
						<input id="deadline" name="deadline" type="datetime-local" value="{{.deadline}}">
					</div>

					<div class="inline field">
						<button class="ui primary button">{{ctx.Locale.Tr "edu.create_assignment"}}</button>
						<a class="ui button" href="{{AppSubUrl}}/edu/teacher/assignments">{{ctx.Locale.Tr "edu.cancel"}}</a>
					</div>
				</div>
			</form>
		</div>
	</div>
</div>
<script>
	var courseSelect = document.getElementById('course_id');
	if (courseSelect) {
		courseSelect.addEventListener('change', function() {
			var courseID = this.value;
			var url = new URL(window.location.href);
			url.searchParams.set('course_id', courseID);
			window.location.href = url.toString();
		});
	}
</script>
{{template "base/footer" .}}
