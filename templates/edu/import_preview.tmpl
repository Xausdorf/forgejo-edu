{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content edu import-preview">
	<div class="ui container">
		{{template "edu/navbar" .}}
		{{template "base/alert" .}}

		<h1 class="ui header">
			{{svg "octicon-eye" 28}}
			{{ctx.Locale.Tr "edu.import_preview"}} — {{.RowCount}} rows
		</h1>
		<p>{{ctx.Locale.Tr "edu.course"}}: <strong>{{.Course.Name}}</strong></p>

		<div class="ui segment" style="overflow-x: auto;">
			<table class="ui celled table">
				<thead>
					<tr>
						<th>#</th>
						<th>{{ctx.Locale.Tr "edu.full_name"}}</th>
						<th>{{ctx.Locale.Tr "edu.username"}}</th>
						<th>{{ctx.Locale.Tr "edu.email"}}</th>
						<th>{{ctx.Locale.Tr "edu.group"}}</th>
						<th>{{ctx.Locale.Tr "edu.status"}}</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{{range $i, $row := .Rows}}
						<tr>
							<td>{{$i}}</td>
							<td>{{$row.FullName}}</td>
							<td colspan="3">
								<form class="ui form" action="{{AppSubUrl}}/edu/teacher/courses/{{$.Course.ID}}/import/{{$.Draft.ID}}/update-row" method="post" style="display: flex; gap: 5px; align-items: center;">
									{{$.CsrfTokenHtml}}
									<input type="hidden" name="row_id" value="{{$row.ID}}">
									<input type="text" name="username" value="{{$row.Username}}" style="width: 150px;" required>
									<input type="text" name="email" value="{{$row.Email}}" placeholder="auto-generated" style="width: 180px;">
									<input type="text" name="group_name" value="{{$row.Group}}" placeholder="{{ctx.Locale.Tr "edu.group_placeholder"}}" style="width: 110px; flex-shrink: 0;">
									<button class="ui mini primary button" type="submit" style="flex-shrink: 0;">{{ctx.Locale.Tr "edu.save"}}</button>
								</form>
							</td>
							<td>
								{{if eq $row.Status "pending"}}
									<span class="ui yellow label">{{ctx.Locale.Tr "edu.pending"}}</span>
								{{else if eq $row.Status "created"}}
									<span class="ui green label">{{ctx.Locale.Tr "edu.created"}}</span>
								{{else if eq $row.Status "exists"}}
									<span class="ui blue label">{{ctx.Locale.Tr "edu.exists"}}</span>
								{{else if eq $row.Status "error"}}
									<span class="ui red label" title="{{$row.ErrorMsg}}">{{ctx.Locale.Tr "edu.error"}}</span>
								{{else}}
									<span class="ui label">{{$row.Status}}</span>
								{{end}}
							</td>
							<td></td>
						</tr>
					{{end}}
				</tbody>
			</table>
		</div>

		<div class="ui segment">
			<form class="ui form" action="{{AppSubUrl}}/edu/teacher/courses/{{.Course.ID}}/import/{{.Draft.ID}}/execute" method="post" style="display: inline;">
				{{.CsrfTokenHtml}}
				<div class="inline field">
					<label>{{ctx.Locale.Tr "edu.default_role"}}</label>
					<select name="default_role" class="ui compact selection dropdown">
						<option value="student" selected>{{ctx.Locale.Tr "edu.student"}}</option>
						<option value="teacher">{{ctx.Locale.Tr "edu.teacher"}}</option>
					</select>
				</div>
				<button class="ui green button" type="submit" onclick="return confirm('{{ctx.Locale.Tr "edu.import_all_confirm"}}')">
					{{svg "octicon-check"}} {{ctx.Locale.Tr "edu.import_all"}}
				</button>
			</form>

			<form action="{{AppSubUrl}}/edu/teacher/courses/{{.Course.ID}}/import/{{.Draft.ID}}/delete" method="post" style="display: inline; margin-left: 10px;">
				{{.CsrfTokenHtml}}
				<button class="ui red button" type="submit">{{svg "octicon-trash"}} {{ctx.Locale.Tr "edu.cancel_import"}}</button>
			</form>
		</div>
	</div>
</div>
{{template "base/footer" .}}
