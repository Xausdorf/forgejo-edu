{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content edu instructor-submissions">
	<div class="ui container">
		{{template "edu/navbar" .}}
		{{template "base/alert" .}}

		<div class="ui grid">
			<div class="sixteen wide column">
				<div class="ui secondary menu">
					<div class="header item">
						<h1 class="ui header" style="margin:0">
							{{.Assignment.Title}} - {{ctx.Locale.Tr "edu.submissions"}}
						</h1>
					</div>
					{{if .IsFullTeacher}}
					<div class="right menu">
						<form action="{{AppSubUrl}}/edu/teacher/assignments/{{.Assignment.ID}}/distribute" method="post" style="margin-left: 5px;">
							{{.CsrfTokenHtml}}
							<button class="ui teal button" type="submit" id="edu-distribute-button" onclick="return confirm('{{ctx.Locale.Tr "edu.distribute_confirm"}}')">
								{{svg "octicon-rocket"}} {{ctx.Locale.Tr "edu.distribute_run"}}
							</button>
						</form>
						<a class="ui button" href="{{AppSubUrl}}/edu/teacher/assignments/{{.Assignment.ID}}/edit" style="margin-left: 5px;">
							{{svg "octicon-pencil"}} {{ctx.Locale.Tr "edu.edit_assignment"}}
						</a>
						<form action="{{AppSubUrl}}/edu/teacher/assignments/{{.Assignment.ID}}/delete" method="post" style="margin-left: 5px;">
							{{.CsrfTokenHtml}}
							<button class="ui red button" onclick="return confirm('{{ctx.Locale.Tr "edu.delete_assignment_confirm"}}')">
								{{svg "octicon-trash"}} {{ctx.Locale.Tr "edu.delete"}}
							</button>
						</form>
					</div>
					{{end}}
				</div>

				{{if .AvailableGroups}}
				<div class="ui segment" id="edu-group-filter-block">
					<form method="get" action="{{AppSubUrl}}/edu/teacher/assignments/{{.Assignment.ID}}/submissions">
						<label><strong>{{ctx.Locale.Tr "edu.group_filter"}}:</strong></label>
						<select name="group" multiple class="ui multiple search dropdown" style="min-width:200px">
							{{$selected := .SelectedGroups}}
							{{range .AvailableGroups}}
								{{$g := .}}
								<option value="{{$g}}" {{range $selected}}{{if eq . $g}}selected{{end}}{{end}}>{{$g}}</option>
							{{end}}
						</select>
						<button class="ui small primary button" type="submit">{{ctx.Locale.Tr "edu.group_filter_apply"}}</button>
						<a class="ui small button" href="{{AppSubUrl}}/edu/teacher/assignments/{{.Assignment.ID}}/submissions">{{ctx.Locale.Tr "edu.group_filter_clear"}}</a>
					</form>
				</div>
				{{end}}

				<div class="ui segment">
					<table class="ui celled table">
						<thead>
							<tr>
								<th>{{ctx.Locale.Tr "edu.student"}}</th>
								<th>{{ctx.Locale.Tr "edu.group"}}</th>
								<th>{{ctx.Locale.Tr "edu.status"}}</th>
								<th>{{ctx.Locale.Tr "edu.ci_score"}}</th>
								<th>{{ctx.Locale.Tr "edu.grade"}}</th>
								<th>{{ctx.Locale.Tr "edu.repo"}}</th>
								<th>{{ctx.Locale.Tr "edu.updated"}}</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
							{{range .Submissions}}
								<tr>
									<td>
										{{with (index $.UserMap .UserID)}}
											{{.Name}}
										{{else}}
											User {{.UserID}}
										{{end}}
									</td>
									<td>
										{{with (index $.EnrollmentMap .ID)}}
											{{if .GroupName}}<span class="ui tiny label">{{.GroupName}}</span>{{end}}
										{{end}}
									</td>
									<td>
										<span class="ui label {{if eq (printf "%s" .Status) "done"}}green{{else if eq (printf "%s" .Status) "failed"}}red{{else if eq (printf "%s" .Status) "running"}}blue{{else if eq (printf "%s" .Status) "approved"}}olive{{else if eq (printf "%s" .Status) "merged"}}purple{{else}}grey{{end}}">
											{{.Status}}
										</span>
									</td>
									<td>
										{{with (index $.TestResultMap .ID)}}
											<span class="ui label {{if ge .Score 50}}green{{else}}red{{end}}">
												{{.Score}}%
											</span>
											<small title="{{.CommitSHA}}">{{if ge (len .CommitSHA) 7}}{{slice .CommitSHA 0 7}}{{else}}{{.CommitSHA}}{{end}}</small>
										{{else}}
											<span class="ui grey label">—</span>
										{{end}}
									</td>
									<td>
										{{if .IsGraded}}
											<span class="ui purple label">{{.Grade}}/100</span>
											{{if .ManualGrade}}
												<small class="ui small orange label" style="margin-left:3px">{{ctx.Locale.Tr "edu.manual_grade_label"}}</small>
											{{else}}
												<small class="ui small teal label" style="margin-left:3px">{{ctx.Locale.Tr "edu.auto_grade"}}</small>
											{{end}}
										{{else}}
											<span class="ui grey label">{{ctx.Locale.Tr "edu.not_graded"}}</span>
										{{end}}
									</td>
									<td>
										{{with (index $.RepoLinkMap .ID)}}<a href="{{AppSubUrl}}/{{.}}">{{ctx.Locale.Tr "edu.fork_branch_link"}}</a>{{end}}
									</td>
									<td>{{(DateUtils).AbsoluteShort .UpdatedUnix}}</td>
									<td>
										<a class="ui mini button" href="{{AppSubUrl}}/edu/teacher/assignments/{{$.Assignment.ID}}/submissions/{{.ID}}">
											{{svg "octicon-eye"}} {{ctx.Locale.Tr "edu.detail"}}
										</a>
									</td>
								</tr>
							{{else}}
								<tr>
									<td colspan="8">{{ctx.Locale.Tr "edu.no_submissions_yet"}}</td>
								</tr>
							{{end}}
						</tbody>
					</table>
				</div>
			</div>

			{{if .DistributeTask}}
			<div class="ui segment" id="edu-distribute-block" data-assignment-id="{{.Assignment.ID}}">
				<h4>{{svg "octicon-rocket"}} {{ctx.Locale.Tr "edu.distribute"}}</h4>
				<div id="edu-distribute-progress"></div>
			</div>
			{{end}}
		</div>
	</div>
</div>
{{if .DistributeTask}}
<script>
	(function() {
		const block = document.getElementById('edu-distribute-block');
		if (!block) return;
		const assignmentID = block.dataset.assignmentId;
		const progressEl = document.getElementById('edu-distribute-progress');
		const buttonEl = document.getElementById('edu-distribute-button');
		if (!progressEl) return;

		function render(data) {
			if (!data || data.status === 'none') {
				progressEl.innerHTML = '';
				return;
			}
			const pushed = data.pushed || 0;
			const failed = data.failed || 0;
			const total = data.total || 0;
			let cls = 'ui label';
			let label = data.status;
			if (data.status === 'running' || data.status === 'pending') {
				cls = 'ui blue label';
				label = '{{ctx.Locale.Tr "edu.distribute_in_progress"}}';
				if (buttonEl) buttonEl.disabled = true;
			} else if (data.status === 'done') {
				cls = 'ui green label';
				label = '{{ctx.Locale.Tr "edu.distribute_done"}}';
				if (buttonEl) buttonEl.disabled = false;
			} else if (data.status === 'error') {
				cls = 'ui red label';
				label = '{{ctx.Locale.Tr "edu.distribute_error"}}';
				if (buttonEl) buttonEl.disabled = false;
			}
			let html = `<span class="${cls}">${label}</span> `;
			html += `{{ctx.Locale.Tr "edu.distribute_progress"}}: ${pushed} / ${total}`;
			if (failed > 0) html += ` (failed: ${failed})`;
			if (data.error_log) {
				const safe = data.error_log.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
				html += `<pre style="margin-top:8px;max-height:200px;overflow:auto;font-size:0.85em">${safe}</pre>`;
			}
			progressEl.innerHTML = html;
		}

		function poll() {
			fetch(`{{AppSubUrl}}/edu/teacher/assignments/${assignmentID}/distribute-status`)
				.then(r => r.json())
				.then(data => {
					render(data);
					if (data.status === 'running' || data.status === 'pending') {
						setTimeout(poll, 2000);
					}
				})
				.catch(err => console.error('distribute-status:', err));
		}
		poll();
	})();
</script>
{{end}}
{{template "base/footer" .}}
